{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/mks-hash/efficient-agentic-inference/schemas/v1/result.schema.json",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "run_id": {
      "type": "string",
      "minLength": 1
    },
    "instance_id": {
      "type": "string",
      "minLength": 1
    },
    "ranked_files": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "disposition": {
      "enum": [
        "valid",
        "invalid_output",
        "truncated",
        "unsupported",
        "runtime_error",
        "timeout"
      ]
    },
    "failure_reason": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "null"
        }
      ]
    },
    "raw_output": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "null"
        }
      ]
    },
    "metrics": {
      "type": "object",
      "properties": {
        "recall_at_k": {
          "type": "object",
          "additionalProperties": {
            "type": [
              "number",
              "null"
            ],
            "minimum": 0,
            "maximum": 1
          }
        },
        "precision_at_k": {
          "type": "object",
          "additionalProperties": {
            "type": [
              "number",
              "null"
            ],
            "minimum": 0,
            "maximum": 1
          }
        },
        "strict_success_at_k": {
          "type": "object",
          "additionalProperties": {
            "type": "boolean"
          }
        },
        "mrr": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 1
        },
        "gold_file_count": {
          "type": "integer",
          "minimum": 0
        }
      },
      "required": [
        "recall_at_k",
        "precision_at_k",
        "strict_success_at_k",
        "mrr",
        "gold_file_count"
      ],
      "additionalProperties": false
    },
    "measurements": {
      "type": "object",
      "properties": {
        "wall_ms": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "input_tokens": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "output_tokens": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "gpu_seconds": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "monetary_usd": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "unknown_reasons": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "required": [
        "wall_ms",
        "input_tokens",
        "output_tokens",
        "gpu_seconds",
        "monetary_usd",
        "unknown_reasons"
      ],
      "additionalProperties": false
    },
    "fallback": {
      "type": "object",
      "properties": {
        "used": {
          "type": "boolean"
        },
        "reason": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "model_revision": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "wall_ms": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "monetary_usd": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        }
      },
      "required": [
        "used",
        "reason",
        "model_revision",
        "wall_ms",
        "monetary_usd"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "schema_version",
    "run_id",
    "instance_id",
    "ranked_files",
    "disposition",
    "failure_reason",
    "raw_output",
    "metrics",
    "measurements",
    "fallback"
  ],
  "additionalProperties": false
}
