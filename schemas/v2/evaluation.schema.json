{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/mks-hash/efficient-agentic-inference/schemas/v2/evaluation.schema.json",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "2.0.0"
    },
    "instance_id": {
      "type": "string",
      "minLength": 1
    },
    "label_status": {
      "enum": [
        "labeled",
        "empty_patch",
        "unsupported_patch",
        "parse_failure"
      ]
    },
    "failure_reason": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "null"
        }
      ]
    },
    "changes": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1
          },
          "old_path": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1
              },
              {
                "type": "null"
              }
            ]
          },
          "new_path": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1
              },
              {
                "type": "null"
              }
            ]
          },
          "status": {
            "enum": [
              "modified",
              "added",
              "deleted",
              "renamed",
              "copied",
              "mode_changed"
            ]
          },
          "category": {
            "enum": [
              "test",
              "implementation",
              "non_code"
            ]
          },
          "binary": {
            "type": "boolean"
          }
        },
        "required": [
          "path",
          "old_path",
          "new_path",
          "status",
          "category",
          "binary"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "schema_version",
    "instance_id",
    "label_status",
    "failure_reason",
    "changes"
  ],
  "additionalProperties": false
}
