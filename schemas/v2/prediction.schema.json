{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/mks-hash/efficient-agentic-inference/schemas/v2/prediction.schema.json",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "2.0.0"
    },
    "instance_id": {
      "type": "string",
      "minLength": 1
    },
    "ranked_files": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "raw_output": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "disposition": {
      "enum": [
        "valid",
        "invalid_output",
        "runtime_error",
        "preparation_failed"
      ]
    },
    "failure_reason": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "null"
        }
      ]
    },
    "candidate_paths": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "candidate_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "measurements": {
      "type": "object",
      "properties": {
        "wall_ms": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "cpu_ms": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "input_tokens": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "output_tokens": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "gpu_seconds": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "monetary_usd": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        }
      },
      "required": [
        "wall_ms",
        "cpu_ms",
        "input_tokens",
        "output_tokens",
        "gpu_seconds",
        "monetary_usd"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "schema_version",
    "instance_id",
    "ranked_files",
    "raw_output",
    "disposition",
    "failure_reason",
    "candidate_paths",
    "candidate_sha256",
    "measurements"
  ],
  "additionalProperties": false
}
