{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/mks-hash/efficient-agentic-inference/schemas/v2/inference.schema.json",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "2.0.0"
    },
    "instance": {
      "type": "object",
      "properties": {
        "instance_id": {
          "type": "string",
          "minLength": 1
        },
        "repository": {
          "type": "string",
          "minLength": 1
        },
        "base_commit": {
          "type": "string",
          "minLength": 1
        },
        "issue": {
          "type": "string",
          "minLength": 1
        },
        "candidates": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "path": {
                "type": "string",
                "minLength": 1
              },
              "text": {
                "type": "string"
              }
            },
            "required": [
              "path",
              "text"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "instance_id",
        "repository",
        "base_commit",
        "issue",
        "candidates"
      ],
      "additionalProperties": false
    },
    "preparation_status": {
      "enum": [
        "prepared",
        "failed_checkout",
        "parse_failure"
      ]
    },
    "failure_reason": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "null"
        }
      ]
    },
    "tree_sha256": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "candidate_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    }
  },
  "required": [
    "schema_version",
    "instance",
    "preparation_status",
    "failure_reason",
    "tree_sha256",
    "candidate_sha256"
  ],
  "additionalProperties": false
}
